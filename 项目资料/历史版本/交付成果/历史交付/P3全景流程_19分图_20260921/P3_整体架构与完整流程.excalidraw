    {
      "id": "11_recall_links-tidy-1-note-0",
      "type": "text",
      "x": 3010,
      "y": 6500,
      "width": 962.984375,
      "height": 30.25,
      "angle": 0,
      "strokeColor": "#222222",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
