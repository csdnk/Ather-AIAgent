      "roundness": null,
      "seed": 1982,
      "version": 1,
      "versionNonce": 1994,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790000000000,
      "link": null,
      "locked": false,
      "text": "RRF = Reciprocal Rank Fusion（倒数排名融合）。60 是平滑参数；按完整记忆标识与版本合并。",
      "originalText": "RRF = Reciprocal Rank Fusion（倒数排名融合）。60 是平滑参数；按完整记忆标识与版本合并。",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.375,
      "autoResize": true,
      "baseline": 22,
      "customData": {}
    },
    {
      "id": "11_recall_links-tidy-1-note-1",
      "type": "text",
      "x": 60,
      "y": 1310,
      "width": 965.0,
      "height": 30.25,
      "angle": 0,
      "strokeColor": "#222222",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "11_recall_links-tidy-1",
      "roundness": null,
      "seed": 1982,
      "version": 1,
      "versionNonce": 1994,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790000000000,
      "link": null,
      "locked": false,
      "text": "本方案融合 Working 与长期记忆；RRF 只合并排名，之后仍须资格核验、完整冲突组与预算处理。",
      "originalText": "本方案融合 Working 与长期记忆；RRF 只合并排名，之后仍须资格核验、完整冲突组与预算处理。",
      "fontSize": 22,
      "fontFamily": 1,
