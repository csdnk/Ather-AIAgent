          </mxCell>
        </object>
        <object id="reference_2" label="过期处理 · 持久状态扫描&#10;项目自研：ThreeFlows.tick → Recall.recover_expired&#10;SQLite 扫描到期的 accepted / running 请求并终止&#10;Temporal 仅为学习对象，未提供 Workflow Replay&#10;controller-runtime 参考属于 Operate，不执行此流程&#10;本步骤不自动从中断节点续跑 Recall" source="runtime/flows/host.py::ThreeFlows.tick; recall/basic/service.py::Recall.recover_expired; recall/basic/service.py::Recall.recover_expired; recall/basic/service.py::Recall.recover_expired; recall/basic/service.py::Recall.recover_expired">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#F1F3F6;strokeColor=#7B8797;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#273545;align=center;verticalAlign=middle;spacing=10;">
