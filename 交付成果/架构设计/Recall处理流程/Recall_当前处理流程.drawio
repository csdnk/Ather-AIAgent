        <object id="reference_3" label="Trace / 节点日志 · 参考概念与规范&#10;概念参考：OpenTelemetry 的 Trace / Span&#10;规范参考：W3C Trace Context 的关联标识&#10;本地实现：observed / Telemetry → node_logs&#10;记录开始、返回、失败、取消及安全摘要&#10;未接 OTel SDK / OTLP，也未证明跨 HTTP 传播" source="runtime/foundation/telemetry.py; runtime/foundation/telemetry.py; runtime/foundation/diagnostics.py; runtime/foundation/telemetry.py">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#F0ECF7;strokeColor=#8E78AA;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#273545;align=center;verticalAlign=middle;spacing=10;">
