      "versionNonce": 475503084,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789974097206,
      "link": null,
      "locked": false,
      "text": "RRF（倒数排名融合）：Σ 1/(60+名次)。Working=[A,B]，长期=[B,C] → B≈.0325、A≈.0164、C≈.0161。",
      "originalText": "RRF（倒数排名融合）：Σ 1/(60+名次)。Working=[A,B]，长期=[B,C] → B≈.0325、A≈.0164、C≈.0161。",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.375,
      "autoResize": true,
      "baseline": 22,
