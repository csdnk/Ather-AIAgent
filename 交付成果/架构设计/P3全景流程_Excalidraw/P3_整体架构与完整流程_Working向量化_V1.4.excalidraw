    },
    {
      "id": "02_recall-tidy-1-note1",
      "type": "text",
      "x": 60,
      "y": 7700,
      "width": 1195,
      "height": 31,
      "angle": 0,
      "strokeColor": "#222222",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
