{
  admin off
  auto_https disable_redirects
  http_port 8080
  https_port 8443
  acme_ca https://acme-v02.api.letsencrypt.org/directory
  servers {
    protocols h1 h2
  }
}
http://:8080 {
  route {
    @gateway_health path /gateway-health
    respond @gateway_health "ok" 200
    redir https://aether-p3-demo-c50c3827.southeastasia.cloudapp.azure.com{uri} 308
  }
}
aether-p3-demo-c50c3827.southeastasia.cloudapp.azure.com {
  encode zstd gzip
  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    Strict-Transport-Security "max-age=86400"
  }
  request_body {
    max_size 70MiB
  }
  @maintenance path /p3/maintenance /p3/maintenance/* /p3/configuration /p3/configuration/* /p3/backups /p3/backups/* /p3/restore-drills /p3/restore-drills/*
  respond @maintenance 404
  handle /identity/admin {
    respond 404
  }
  handle /identity/admin/* {
    respond 404
  }
  handle /agent {
    redir * /agent/ 308
  }
  handle /agent/* {
    reverse_proxy aether-platform:19010 {
      transport http {
        response_header_timeout 300s
      }
    }
  }
  handle /temporal {
    redir * /temporal/ 308
  }
  handle /temporal/* {
    forward_auth aether-platform:19010 {
      uri /agent/ops/temporal-auth
    }
    reverse_proxy temporal-ui:8080
  }
  handle /identity/* {
    reverse_proxy aether-keycloak:8080
  }
  handle /api/global/auth/oidc/callback {
    reverse_proxy aether-budibase:80 {
      header_down Location ^/$ /app/default%20workspace/aether-admin
      header_down Location ^https://aether-p3-demo-c50c3827\.southeastasia\.cloudapp\.azure\.com/?$ /app/default%20workspace/aether-admin
    }
  }
  handle / {
    redir * /agent/ 302
  }
  handle /docs {
    forward_auth aether-platform:19010 {
      uri /agent/ops/temporal-auth
    }
    root * /srv/p3-docs
    rewrite * /index.html
    file_server
  }
  handle /openapi.json {
    forward_auth aether-platform:19010 {
      uri /agent/ops/temporal-auth
    }
    reverse_proxy aether-agent-p3:8080
  }
  @retired path /p3 /p3/* /redoc
  handle @retired {
    respond 404
  }
  handle {
    reverse_proxy aether-budibase:80 {
      transport http {
        response_header_timeout 300s
      }
    }
  }
}
