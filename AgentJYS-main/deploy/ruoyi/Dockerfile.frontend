FROM node:22-bookworm-slim AS build
WORKDIR /build
RUN npm install -g pnpm@10.32.1
COPY ruoyi/frontend/package.json ruoyi/frontend/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY ruoyi/frontend/ ./
ENV VITE_BASE_PATH=/ruoyi/ VITE_BASE_URL="" VITE_API_URL=/ruoyi-api VITE_OUT_DIR=dist-prod VITE_APP_TENANT_ENABLE=false VITE_APP_CAPTCHA_ENABLE=false
RUN pnpm build:prod

FROM nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8
COPY deploy/ruoyi/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist-prod/ /usr/share/nginx/html/ruoyi/
EXPOSE 8080
