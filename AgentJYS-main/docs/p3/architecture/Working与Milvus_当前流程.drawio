        <mxCell id="write" value="写入与发布" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#263d57;fontSize=23;" vertex="1" parent="1">
          <mxGeometry x="50" y="135" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="w-note1" value="保存确认 ≠ 索引就绪。写入响应丢失时查询原操作；当前版本、授权与删除状态决定能否发布。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#263d57;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="50" y="348" width="1500" height="35" as="geometry" />
        </mxCell>
        <mxCell id="w-note2" value="索引记录保存引用与校验信息；权威正文仍由 Remember 及其正文后端负责。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#263d57;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="50" y="386" width="1500" height="35" as="geometry" />
        </mxCell>
        <mxCell id="recall" value="语义召回：Working 与长期共享向量机制，按来源隔离" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#263d57;fontSize=23;" vertex="1" parent="1">
          <mxGeometry x="50" y="452" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r-note1" value="索引 pending / failed 进入来源覆盖；仅 pending 且无可交付内容时表达进行中，不能伪装为正常 empty。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#263d57;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="50" y="680" width="1500" height="35" as="geometry" />
        </mxCell>
        <mxCell id="r-note2" value="缺失依赖按实际原因处理；正常空结果需要所选来源正常完成。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#263d57;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="50" y="718" width="1500" height="35" as="geometry" />
        </mxCell>
        <mxCell id="body-title" value="正文读取与安全边界" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#263d57;fontSize=23;" vertex="1" parent="1">
          <mxGeometry x="50" y="769" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;本地开发配置与验收边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;127.0.0.1 · Lite max-workers=1 · P3 写入串行 · 单目录单写入服务 · 重启复用同一物理数据目录&lt;br&gt;Lite 本地开发，无服务端 TLS/RBAC；生产集群、吞吐 SLA、长稳与统计性语义质量未验收。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff6e6;strokeColor=#dcb86c;fontFamily=Microsoft YaHei;fontSize=19;align=left;spacing=18;" vertex="1" parent="1">
