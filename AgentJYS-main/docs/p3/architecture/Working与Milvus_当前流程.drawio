        <mxCell id="subtitle" value="当前实现流程 · 2026-10-01 · 原生 BGE / 官方 Milvus Lite / 统一 P3 服务" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#263d57;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="50" y="77" width="1500" height="35" as="geometry" />
