{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "locator": {
      "minLength": 1,
      "title": "Locator",
      "type": "string"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "source_version": {
      "minimum": 1,
      "title": "Source Version",
      "type": "integer"
    }
  },
  "required": [
    "source_id",
    "source_version",
    "content_hash",
    "locator"
  ],
  "title": "SourceRef",
  "type": "object",
  "x-contract-model": "remember.SourceRef"
}
