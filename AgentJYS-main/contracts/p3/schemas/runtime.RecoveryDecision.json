{
  "$defs": {
    "EffectStatus": {
      "enum": [
        "not_started",
        "no_effect",
        "unknown",
        "confirmed"
      ],
      "title": "EffectStatus",
      "type": "string"
    },
    "Flow": {
      "enum": [
        "runtime",
        "remember",
        "recall",
        "operate"
      ],
      "title": "Flow",
      "type": "string"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Object Type",
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/Flow"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "owner",
        "object_type",
        "object_id",
        "scope"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "RecoveryAction": {
      "enum": [
        "resume",
        "query_only",
        "cancel",
        "fail",
        "attention"
      ],
      "title": "RecoveryAction",
      "type": "string"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Agent Id",
          "type": "string"
        },
        "application_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Application Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "user_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "application_id",
        "user_id",
        "agent_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/RecoveryAction"
    },
    "effect_status": {
      "$ref": "#/$defs/EffectStatus"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "original_operation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Operation Id"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "action",
    "effect_status",
    "reason",
    "evidence"
  ],
  "title": "RecoveryDecision",
  "type": "object",
  "x-contract-model": "runtime.RecoveryDecision"
}
