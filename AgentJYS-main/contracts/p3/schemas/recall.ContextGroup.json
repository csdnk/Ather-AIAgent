{
  "$defs": {
    "ConflictGroup": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "group_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Group Id",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/MemoryRef"
          },
          "minItems": 2,
          "title": "Members",
          "type": "array"
        },
        "state": {
          "const": "unresolved",
          "default": "unresolved",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "members",
        "explanation"
      ],
      "title": "ConflictGroup",
      "type": "object"
    },
    "ContextItem": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "memory": {
          "$ref": "#/$defs/MemoryRef"
        },
        "passages": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OriginalPassage"
          },
          "title": "Passages",
          "type": "array"
        },
        "representation": {
          "enum": [
            "original",
            "compressed",
            "original_passages"
          ],
          "title": "Representation",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "memory",
        "content",
        "sources",
        "representation"
      ],
      "title": "ContextItem",
      "type": "object"
    },
    "MemoryRef": {
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Memory Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "memory_id",
        "version"
      ],
      "title": "MemoryRef",
      "type": "object"
    },
    "OriginalPassage": {
      "additionalProperties": false,
      "description": "A verified vector chunk of the original, with Unicode character offsets.",
      "properties": {
        "body_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Body Hash",
          "type": "string"
        },
        "chunk_index": {
          "minimum": 0,
          "title": "Chunk Index",
          "type": "integer"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "end_char": {
          "minimum": 1,
          "title": "End Char",
          "type": "integer"
        },
        "range_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Range Hash",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "total_chars": {
          "minimum": 1,
          "title": "Total Chars",
          "type": "integer"
        },
        "vector_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Vector Id",
          "type": "string"
        }
      },
      "required": [
        "chunk_index",
        "vector_id",
        "start_char",
        "end_char",
        "total_chars",
        "body_hash",
        "range_hash",
        "content"
      ],
      "title": "OriginalPassage",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Agent Id",
          "type": "string"
        },
        "application_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Application Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "user_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "application_id",
        "user_id",
        "agent_id"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "content_hash",
        "locator"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conflict": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConflictGroup"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "group_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Group Id",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ContextItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "group_id",
    "items"
  ],
  "title": "ContextGroup",
  "type": "object",
  "x-contract-model": "recall.ContextGroup"
}
