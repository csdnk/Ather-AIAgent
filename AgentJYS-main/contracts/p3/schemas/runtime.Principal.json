{
  "$defs": {
    "Permission": {
      "enum": [
        "memory:read",
        "memory:write",
        "memory:correct",
        "memory:delete",
        "memory:history",
        "maintenance:diagnose",
        "maintenance:recover",
        "maintenance:configure"
      ],
      "title": "Permission",
      "type": "string"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Agent Id",
          "type": "string"
        },
        "application_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Application Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "user_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "application_id",
        "user_id",
        "agent_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "auth_epoch": {
      "minimum": 1,
      "title": "Auth Epoch",
      "type": "integer"
    },
    "home_scope": {
      "$ref": "#/$defs/Scope"
    },
    "permissions": {
      "items": {
        "$ref": "#/$defs/Permission"
      },
      "title": "Permissions",
      "type": "array"
    },
    "principal_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Principal Id",
      "type": "string"
    }
  },
  "required": [
    "principal_id",
    "home_scope",
    "permissions",
    "auth_epoch"
  ],
  "title": "Principal",
  "type": "object",
  "x-contract-model": "runtime.Principal"
}
