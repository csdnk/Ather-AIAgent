{
  "$defs": {
    "ScopeSelector": {
      "additionalProperties": false,
      "description": "A requested restriction. Missing fields never grant access.",
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "application_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Application Id"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "user_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "title": "ScopeSelector",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "expected_revision": {
      "default": 0,
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "importance_threshold": {
      "default": 0.8,
      "maximum": 1,
      "minimum": 0.8,
      "title": "Importance Threshold",
      "type": "number"
    },
    "max_episodes": {
      "default": 8,
      "maximum": 32,
      "minimum": 2,
      "title": "Max Episodes",
      "type": "integer"
    },
    "min_episodes": {
      "default": 3,
      "maximum": 32,
      "minimum": 2,
      "title": "Min Episodes",
      "type": "integer"
    },
    "min_reinforcements": {
      "default": 3,
      "minimum": 1,
      "title": "Min Reinforcements",
      "type": "integer"
    },
    "period_hours": {
      "default": 24,
      "maximum": 720,
      "minimum": 1,
      "title": "Period Hours",
      "type": "number"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "selection": {
      "$ref": "#/$defs/ScopeSelector"
    }
  },
  "required": [
    "selection",
    "reason"
  ],
  "title": "ReflectionRequest",
  "type": "object",
  "x-contract-model": "remember.ReflectionRequest"
}
