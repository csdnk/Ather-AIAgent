        "model_space": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Model Space",
          "type": "string"
        },
        "vector_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Vector Id",
          "type": "string"
        }
      },
      "required": [
        "memory",
        "model_space",
        "chunk_index",
        "vector_id",
        "input_hash"
      ],
      "title": "ProjectionTarget",
      "type": "object"
    },
    "Scope": {
