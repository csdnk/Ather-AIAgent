{
  "$defs": {
    "MemoryRef": {
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Memory Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "memory_id",
        "version"
      ],
      "title": "MemoryRef",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Agent Id",
          "type": "string"
        },
        "application_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Application Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "user_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "application_id",
        "user_id",
        "agent_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "body_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Body Hash",
      "type": "string"
    },
    "chunk_index": {
      "minimum": 0,
      "title": "Chunk Index",
      "type": "integer"
    },
    "generation": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Generation",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "memory": {
      "$ref": "#/$defs/MemoryRef"
    },
    "model_space": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Model Space",
      "type": "string"
    },
    "rank": {
      "minimum": 1,
      "title": "Rank",
      "type": "integer"
    },
    "score": {
      "title": "Score",
      "type": "number"
    },
    "score_semantics": {
      "const": "higher_is_better",
      "default": "higher_is_better",
      "title": "Score Semantics",
      "type": "string"
    },
    "vector_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Vector Id",
      "type": "string"
    }
  },
  "required": [
    "memory",
    "generation",
    "body_hash",
    "model_space",
    "chunk_index",
    "vector_id",
    "input_hash",
    "rank",
    "score"
  ],
  "title": "ChunkHit",
  "type": "object",
  "x-contract-model": "recall.ChunkHit"
}
