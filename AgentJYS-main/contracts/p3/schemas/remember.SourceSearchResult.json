{
  "$defs": {
    "SourcePassage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "end_char": {
          "minimum": 1,
          "title": "End Char",
          "type": "integer"
        },
        "range_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Range Hash",
          "type": "string"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "seed": {
          "title": "Seed",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "content",
        "start_char",
        "end_char",
        "range_hash",
        "score",
        "seed"
      ],
      "title": "SourcePassage",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "content_hash",
        "locator"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "jieba_bm25plus_v1",
      "default": "jieba_bm25plus_v1",
      "title": "Algorithm",
      "type": "string"
    },
    "passages": {
      "items": {
        "$ref": "#/$defs/SourcePassage"
      },
      "title": "Passages",
      "type": "array"
    },
    "representation": {
      "const": "source_passages",
      "default": "source_passages",
      "title": "Representation",
      "type": "string"
    }
  },
  "required": [
    "passages"
  ],
  "title": "SourceSearchResult",
  "type": "object",
  "x-contract-model": "remember.SourceSearchResult"
}
