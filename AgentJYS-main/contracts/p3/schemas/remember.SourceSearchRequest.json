{
  "$defs": {
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "content_hash",
        "locator"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "max_chars": {
      "default": 6000,
      "maximum": 20000,
      "minimum": 1,
      "title": "Max Chars",
      "type": "integer"
    },
    "max_passages": {
      "default": 6,
      "maximum": 12,
      "minimum": 1,
      "title": "Max Passages",
      "type": "integer"
    },
    "neighbor_chunks": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Neighbor Chunks",
      "type": "integer"
    },
    "query": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "sources",
    "query"
  ],
  "title": "SourceSearchRequest",
  "type": "object",
  "x-contract-model": "remember.SourceSearchRequest"
}
