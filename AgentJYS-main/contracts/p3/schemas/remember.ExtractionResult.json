{
  "$defs": {
    "CandidateFact": {
      "additionalProperties": false,
      "properties": {
        "evidence_status": {
          "enum": [
            "candidate",
            "supported",
            "insufficient"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "sources",
        "evidence_status"
      ],
      "title": "CandidateFact",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "content_hash",
        "locator"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateFact"
      },
      "title": "Candidates",
      "type": "array"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Policy Version",
      "type": "string"
    }
  },
  "required": [
    "candidates",
    "model_id",
    "policy_version"
  ],
  "title": "ExtractionResult",
  "type": "object",
  "x-contract-model": "remember.ExtractionResult"
}
