{
  "$defs": {
    "MemoryRef": {
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Memory Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "memory_id",
        "version"
      ],
      "title": "MemoryRef",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Agent Id",
          "type": "string"
        },
        "application_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Application Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "user_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "application_id",
        "user_id",
        "agent_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "memory": {
      "$ref": "#/$defs/MemoryRef"
    },
    "rrf_contribution": {
      "exclusiveMinimum": 0,
      "title": "Rrf Contribution",
      "type": "number"
    },
    "rrf_k": {
      "minimum": 1,
      "title": "Rrf K",
      "type": "integer"
    },
    "source": {
      "enum": [
        "working",
        "long_term"
      ],
      "title": "Source",
      "type": "string"
    },
    "source_rank": {
      "minimum": 1,
      "title": "Source Rank",
      "type": "integer"
    }
  },
  "required": [
    "memory",
    "source",
    "source_rank",
    "rrf_k",
    "rrf_contribution"
  ],
  "title": "RankingEvidence",
  "type": "object",
  "x-contract-model": "recall.RankingEvidence"
}
