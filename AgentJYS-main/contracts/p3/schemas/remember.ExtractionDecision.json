{
  "$defs": {
    "CandidateFact": {
      "additionalProperties": false,
      "properties": {
        "event_key": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Key"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FactEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_status": {
          "enum": [
            "candidate",
            "supported",
            "insufficient"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "fact_key": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fact Key"
        },
        "importance_category": {
          "default": "event",
          "enum": [
            "event",
            "fact",
            "decision",
            "explicit_constraint"
          ],
          "title": "Importance Category",
          "type": "string"
        },
        "kind": {
          "default": "episodic",
          "enum": [
            "episodic",
            "semantic"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "sources",
        "evidence_status"
      ],
      "title": "CandidateFact",
      "type": "object"
    },
    "FactEvidence": {
      "additionalProperties": false,
      "properties": {
        "end_char": {
          "minimum": 1,
          "title": "End Char",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "start_char",
        "end_char",
        "quote"
      ],
      "title": "FactEvidence",
      "type": "object"
    },
    "MemoryRef": {
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Memory Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "memory_id",
        "version"
      ],
      "title": "MemoryRef",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Agent Id",
          "type": "string"
        },
        "application_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Application Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "user_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "application_id",
        "user_id",
        "agent_id"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "content_hash",
        "locator"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/CandidateFact"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Decision Id",
      "type": "string"
    },
    "expected_object_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Object Revision"
    },
    "outcome": {
      "enum": [
        "create",
        "correct",
        "no_change",
        "reject"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Policy Version",
      "type": "string"
    },
    "processing_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Processing Id",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Reason Code",
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "decision_id",
    "processing_id",
    "candidate",
    "outcome",
    "policy_version",
    "reason_code"
  ],
  "title": "ExtractionDecision",
  "type": "object",
  "x-contract-model": "remember.ExtractionDecision"
}
