{
  "$defs": {
    "Flow": {
      "enum": [
        "runtime",
        "remember",
        "recall",
        "operate"
      ],
      "title": "Flow",
      "type": "string"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Object Type",
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/Flow"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "owner",
        "object_type",
        "object_id",
        "scope"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "ResourceLocation": {
      "additionalProperties": false,
      "description": "An opaque provider key, never an arbitrary URL or a credential.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "generation": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Generation",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "body",
            "artifact",
            "vector",
            "cache",
            "backup"
          ],
          "title": "Kind",
          "type": "string"
        },
        "namespace": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Namespace",
          "type": "string"
        },
        "object_key": {
          "minLength": 1,
          "title": "Object Key",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_instance_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Provider Instance Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "provider_id",
        "provider_instance_id",
        "namespace",
        "object_key",
        "generation",
        "content_hash"
      ],
      "title": "ResourceLocation",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Agent Id",
          "type": "string"
        },
        "application_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Application Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "user_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "application_id",
        "user_id",
        "agent_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "enum": [
        "absent",
        "deleted",
        "failed",
        "unknown",
        "protected"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Reason Code",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ResourceLocation"
    }
  },
  "required": [
    "target",
    "outcome",
    "reason_code"
  ],
  "title": "CleanupTargetResult",
  "type": "object",
  "x-contract-model": "remember.CleanupTargetResult"
}
