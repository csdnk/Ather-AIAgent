{
  "$defs": {
    "Flow": {
      "enum": [
        "runtime",
        "remember",
        "recall",
        "operate"
      ],
      "title": "Flow",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "label_names": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "title": "Label Names",
      "type": "array"
    },
    "max_label_sets": {
      "minimum": 1,
      "title": "Max Label Sets",
      "type": "integer"
    },
    "missing_policy": {
      "const": "unknown",
      "default": "unknown",
      "title": "Missing Policy",
      "type": "string"
    },
    "owner": {
      "$ref": "#/$defs/Flow"
    },
    "sample_interval_ms": {
      "minimum": 1,
      "title": "Sample Interval Ms",
      "type": "integer"
    },
    "signal_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Signal Id",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "stale_after_ms": {
      "minimum": 1,
      "title": "Stale After Ms",
      "type": "integer"
    },
    "unit": {
      "enum": [
        "count",
        "milliseconds",
        "bytes",
        "ratio",
        "state"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "signal_id",
    "owner",
    "source",
    "unit",
    "sample_interval_ms",
    "stale_after_ms",
    "label_names",
    "max_label_sets"
  ],
  "title": "SignalDefinition",
  "type": "object",
  "x-contract-model": "runtime.SignalDefinition"
}
