{
  "$defs": {
    "ScopeSelector": {
      "additionalProperties": false,
      "description": "A requested restriction. Missing fields never grant access.",
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "application_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Application Id"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "user_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "title": "ScopeSelector",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "query": {
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "selection": {
      "$ref": "#/$defs/ScopeSelector"
    },
    "sources": {
      "default": "auto",
      "enum": [
        "auto",
        "working",
        "long_term",
        "both"
      ],
      "title": "Sources",
      "type": "string"
    },
    "token_budget": {
      "default": 1024,
      "minimum": 1,
      "title": "Token Budget",
      "type": "integer"
    }
  },
  "required": [
    "query",
    "selection"
  ],
  "title": "RecallRequest",
  "type": "object",
  "x-contract-model": "recall.RecallRequest"
}
